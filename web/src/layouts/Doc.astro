---
import "../styles/app.css";
import { EFFECTIVE_DATE } from "../legal.ts";
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜タダシガキ</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='4' y='12' width='24' height='9' rx='2' fill='%2356b4e9'/%3E%3C/svg%3E" />
  </head>
  <body>
    <main class="wrap legal">
      <p class="back"><a href="/">← タダシガキへ戻る</a></p>
      <article class="paper">
        {!EFFECTIVE_DATE && <p class="draft" role="note">公開前の版です。施行日は公開の日に入ります。</p>}
        <slot />
      </article>
    </main>
  </body>
</html>
<style is:global>
  .legal { padding-top: 24px; padding-bottom: 48px; max-width: 820px; }
  .legal .back { font-size: 14px; margin: 0 0 12px; }
  .legal h1 { font-size: 22px; margin: 0 0 8px; }
  .legal h2 { font-size: 16px; margin: 1.8em 0 .5em; }
  .legal p, .legal li { font-size: 15.5px; line-height: 1.85; }
  .legal ol, .legal ul { padding-left: 1.4em; }
  .legal .draft { font-size: 13px; background: var(--bg); border: 1px dashed var(--ink-3); border-radius: 8px; padding: 6px 10px; margin: 0 0 18px; }
  .legal .meta { font-size: 13px; color: var(--ink-2); }
</style>
